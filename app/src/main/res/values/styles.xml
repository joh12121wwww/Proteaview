<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Proteaview"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Proteaview colours -->
        <item name="colorPrimary">#FFD400</item>
        <item name="colorPrimaryVariant">#C7A600</item>
        <item name="colorAccent">#FFD400</item>

        <!-- Dark interface -->
        <item name="android:windowBackground">#080A0C</item>
        <item name="android:statusBarColor">#080A0C</item>
        <item name="android:navigationBarColor">#080A0C</item>

        <!-- White status bar icons -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Clean modern typography -->
        <item name="android:fontFamily">sans</item>

        <!-- Edge-to-edge dark appearance -->
        <item name="android:windowActionModeOverlay">true</item>

    </style>

</resources>
